# Copy to .env (used by docker compose and by `npm run dev` in apps/api).
DATABASE_URL=postgres://triago:triago@localhost:5432/triago
# At least 32 characters in production. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
# Number of reverse proxies in front of the API. Keep 0 unless one sets X-Forwarded-For.
TRUST_PROXY=0
# Optional: a free key from https://console.groq.com/keys lets an AI model draft new emails;
# without one, keyword rules draft them.
GROQ_API_KEY=
# CLASSIFIER_MODEL=llama-3.3-70b-versatile
# Optional: real inbound email through SendGrid Inbound Parse (see docs/inbound-email.md).
# INBOUND_EMAIL_DOMAIN=in.example.com
# INBOUND_WEBHOOK_SECRET=  # openssl rand -hex 32; goes in the SendGrid webhook URL
# Optional: connect a Gmail mailbox per organisation (see docs/gmail.md).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=  # defaults to <CLIENT_ORIGIN>/api/gmail/callback
# Optional: only `npm run db:migrate:dev -w apps/api` (new migrations) needs it.
SHADOW_DATABASE_URL=postgres://triago:triago@localhost:5432/triago_shadow
